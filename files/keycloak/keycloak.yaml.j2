# Сгенерировано Ansible из files/keycloak/keycloak.yaml.j2. Значения — из vars/keycloak.yml и keycloak.env.
services:
  keycloak:
    container_name: keycloak
    network_mode: host
    dns:
      - {{ dns_server }}
    env_file: keycloak.env            # логины и пароли: БД и первый админ (вне git)
    command:
      - start
      - --spi-sticky-session-encoder--infinispan--should-attach-route=false
      - --spi-user-profile--declarative-user-profile--read-only-attributes=*_RES_ACCESS_MODE
    environment:
      KC_HOSTNAME: "{{ kc_hostname }}"
      KC_PROXY_TRUSTED_ADDRESSES: "{{ (kc_proxies + ['172.16.0.0/12']) | join(',') }}"
      KC_PROXY_HEADERS: 'xforwarded'
      TZ: "{{ kc_timezone }}"
      KC_HTTP_ENABLED: true
      KC_DB: 'mariadb'
      KC_DB_URL: '{{ kc_db_url }}'
      KC_HEALTH_ENABLED: true
      KC_METRICS_ENABLED: true
      KC_FEATURES: 'scripts'
      KC_FEATURES_DISABLED: 'twitter-broker,identity-brokering-api'
{% if kc_ca_cert %}
      KC_TRUSTSTORE_PATHS: '/opt/keycloak/{{ kc_ca_cert }}'
{% endif %}
      KC_CACHE: 'ispn'
      KC_HTTP_PORT: 28080
      KC_CACHE_STACK: 'jdbc-ping'
      QUARKUS_THREAD_POOL_QUEUE_SIZE: 1000
      JAVA_OPTS_APPEND: "-Djgroups.bind.address={{ nodeip }} -Xms512m -Xmx2048m"
    image: quay.io/keycloak/keycloak:latest
    restart: unless-stopped
{% if kc_ca_cert or kc_keytab %}
    volumes:
{% if kc_ca_cert %}
      - ./{{ kc_ca_cert }}:/opt/keycloak/{{ kc_ca_cert }}:ro
{% endif %}
{% if kc_keytab %}
      - ./{{ kc_keytab }}:/etc/krb5.keytab:ro
{% endif %}
{% endif %}


    healthcheck:
      test:
        - CMD-SHELL
        - >-
          exec 3<>/dev/tcp/127.0.0.1/9000 &&
          printf 'GET /health/ready HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n' >&3 &&
          grep -q '"UP"' <&3
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 120s
